#!/bin/bash
set -euo pipefail

# La clave de Actions solo puede solicitar un commit hexadecimal completo.
if [[ ${SSH_ORIGINAL_COMMAND:-} =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
    exec sudo -n -- /usr/local/sbin/alas-deploy "${BASH_REMATCH[1]}"
fi
echo 'Comando no permitido para esta clave.' >&2
exit 1
